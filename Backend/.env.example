# Backend Environment Variables
# Copy this file to .env and fill in your values

# MongoDB Connection
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/spotify-clone?retryWrites=true&w=majority

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ImageKit Configuration (for music file uploads)
IMAGEKIT_PRIVATE_KEY=your-imagekit-private-key-here

# Server Port
PORT=3000

# Node Environment
NODE_ENV=development

# Set to "configured" only after a real password-reset delivery provider is wired.
PASSWORD_RESET_DELIVERY=unconfigured
